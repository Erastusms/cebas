# ==============================================================================
# CEBAS (Celoteh Bebas) - Environment Configuration Baseline (Phase 0)
# ==============================================================================

# Backend Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# PostgreSQL 16 Primary Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cebas_db
POSTGRES_USER=cebas_admin
POSTGRES_PASSWORD=cebas_secure_dev_password

# PgBouncer Connection Pooler
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Redis 7 Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=cebas_minio_admin
MINIO_SECRET_KEY=cebas_minio_secure_password
MINIO_BUCKET=cebas-media
MINIO_CONSOLE_PORT=9001

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
